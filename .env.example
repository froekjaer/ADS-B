# Copy this file to .env and edit the values for your station.
# Never commit your real .env file if it later contains feed keys.

FEEDER_TZ=Europe/Copenhagen
FEEDER_LAT=55.00000
FEEDER_LONG=9.00000
FEEDER_ALT_M=50

# RTL-SDR serial number. If you only have one SDR, 00000001 is common.
# You can inspect devices with: rtl_test -t
ADSB_SDR_SERIAL=00000001

# Start with automatic gain. Fine-tune later if needed.
ADSB_GAIN=auto
ADSB_SDR_PPM=0

AIS_SDR_SERIAL=YOUR_AIS_SDR_SERIAL
